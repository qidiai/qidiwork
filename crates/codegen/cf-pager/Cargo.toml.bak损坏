[package]
name = "cf-pager"
version = "0.1.220-alpha.4"
edition.workspace = true
license = "Apache-2.0"

[dependencies]
cf-telemetry = { path = "../cf-telemetry" }
cf-version = { workspace = true }
dunce = { workspace = true }
cf-tty-utils = { workspace = true }
cf-prompt-queue = { workspace = true }
cf-pager-render = { path = "../cf-pager-render" }
ratatui = { workspace = true, features = ["crossterm", "unstable-widget-ref"] }
cf-office-preview = { path = "../cf-office-preview" }
crossterm = { workspace = true, features = ["event-stream", "bracketed-paste"] }
textwrap = { workspace = true }
regex = { workspace = true }
unicode-width = { workspace = true }
unicode-segmentation = { workspace = true }
strip-ansi-escapes = { workspace = true }

[dev-dependencies]
criterion = { workspace = true }
tempfile = { workspace = true }

[build-dependencies]
cc = { workspace = true }

[features]
default = ["jemalloc", "sandbox-enforce"]
jemalloc = []
sandbox-enforce = ["cf-sandbox/enforce"]
test-helpers = ["cf-pager-render/test-helpers"]